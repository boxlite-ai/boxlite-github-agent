{
  "display_information": {
    "name": "BoxLite",
    "description": "An agent for Slack and coding tasks, with conversations, tools and saved automations.",
    "background_color": "#1f2328"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "boxliteai",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "Ask questions, take action in Slack, work on code, or save a recurring task.",
      "suggested_prompts": [
        {
          "title": "Explore capabilities",
          "message": "What can you do in Slack?"
        },
        {
          "title": "Summarize a conversation",
          "message": "Summarize this conversation and its next steps."
        }
      ]
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "reactions:write",
        "users:read",
        "files:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "assistant:write",
        "channels:read",
        "groups:read",
        "search:read.public"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im",
        "message.channels",
        "message.groups",
        "agent_session_stopped",
        "app_context_changed"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
